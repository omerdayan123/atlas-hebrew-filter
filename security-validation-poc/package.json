{
  "name": "security-validation-poc",
  "version": "0.1.0",
  "private": true,
  "description": "POC: client-side Hebrew security text validation with server source-of-truth",
  "type": "module",
  "scripts": {
    "build:web": "esbuild src/web/browser-engine.ts --bundle --format=iife --global-name=SecurityValidation --outfile=public/engine.js --sourcemap",
    "dev:web": "esbuild src/web/browser-engine.ts --bundle --format=iife --global-name=SecurityValidation --outfile=public/engine.js --sourcemap --watch",
    "start": "tsx src/server/index.ts",
    "build-and-start": "npm run build:web && npm run start"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.5",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
